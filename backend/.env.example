# Copiar a `.env` y completar con valores reales. NUNCA versionar `.env`.
# Variables mínimas de Fase 0 (el backend las lee desde el entorno o .env).

# PostgreSQL. En producción: Neon (conexión SSL requerida).
# Pooled (la app): DATABASE_URL  |  Directa (Alembic/migraciones): DATABASE_URL_UNPOOLED
DATABASE_URL=postgresql://usuario:password@host.neon.tech/agua_renew_asistencia?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://usuario:password@host-direct.neon.tech/agua_renew_asistencia?sslmode=require

# Clave para firmar sesiones/JWT. MÍNIMO 32 bytes (JWT rechaza claves cortas con warning).
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-replace-with-a-random-64-char-key!!

# development | production
ENVIRONMENT=development

# Origen permitido en CORS (producción: dominio de Vercel).
FRONTEND_URL=http://localhost:3000

# Zona horaria oficial del negocio.
TIMEZONE=America/Lima
